input_stream: "IMAGE:input_video"
output_stream: "IMAGE:output"

node {
  calculator: "ImageToTensorCalculator"
  input_stream: "IMAGE:input_video"
  output_stream: "TENSOR:mediapipe_image_tensor"
  node_options: {
    [type.googleapis.com/mediapipe.ImageToTensorCalculatorOptions] {
      output_tensor_width: 416
      output_tensor_height: 416
      output_tensor_float_range { min: 0.0 max: 255.0 }
    }
  }
}

node {
  calculator: "MPTensorToOVTensorCalculator"
  input_stream: "TENSOR:mediapipe_image_tensor"
  output_stream: "OVTENSOR:image_tensor"
}

node {
  calculator: "OpenVINOSessionCalculator"
  output_side_packet: "SESSION:session"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOSessionCalculatorOptions] {
      model_path: "/demo/yolox_tiny-fp16-ov/1/yolox_tiny-fp16-ov.xml"
      device: "CPU"
      num_infer_requests: 4
    }
        output_stream: "TENSOR:mediapipe_image_tensor"
}

node {
  calculator: "OpenVINOInferenceCalculator"
        input_stream: "TENSOR:mediapipe_image_tensor"
  input_stream: "IMAGE:image_tensor"
  output_stream: "TENSORS:detection_tensors"
  node_options: {
    [type.googleapis.com/mediapipe.OpenVINOInferenceCalculatorOptions] {
      tag_to_input_tensor_names { key: "IMAGE" value: "image" }
      output_order: "boxes"
      output_order: "labels"
    }
  }
}

node {
  calculator: "OVYoloXTensorsToDetectionsCalculator"
  input_stream: "TENSORS:detection_tensors"
  output_stream: "DETECTIONS:detections"

  node_options: {
    [type.googleapis.com/mediapipe.OVYoloXTensorsToDetectionsCalculatorOptions] {
        input_stream: "IMAGE:image_tensor"
      input_size: 416.0
    }
  }
            tag_to_input_tensor_names { key: "IMAGE" value: "image" }

# Performs non-max suppression to remove excessive detections.
node {
  calculator: "NonMaxSuppressionCalculator"
  input_stream: "detections"
  output_stream: "filtered_detections"
  node_options: {
    [type.googleapis.com/mediapipe.NonMaxSuppressionCalculatorOptions] {
      min_suppression_threshold: 0.45
      node {
        calculator: "ImageToTensorCalculator"
        input_stream: "IMAGE:input_video"
        output_stream: "TENSOR:mediapipe_image_tensor"
        node_options: {
          [type.googleapis.com/mediapipe.ImageToTensorCalculatorOptions] {
            output_tensor_width: 416
            output_tensor_height: 416
            output_tensor_float_range { min: 0.0 max: 255.0 }
          }
        }
      }

      node {
        calculator: "MPTensorToOVTensorCalculator"
        input_stream: "TENSOR:mediapipe_image_tensor"
        output_stream: "OVTENSOR:image_tensor"
      }

      node {
        calculator: "OpenVINOSessionCalculator"
        output_side_packet: "SESSION:session"
        node_options: {
          [type.googleapis.com/mediapipe.OpenVINOSessionCalculatorOptions] {
            model_path: "/demo/yolox_tiny-fp16-ov/1/yolox_tiny-fp16-ov.xml"
            device: "CPU"
            num_infer_requests: 4
          }
        }
      }

      node {
        calculator: "OpenVINOInferenceCalculator"
        input_side_packet: "SESSION:session"
        input_stream: "IMAGE:image_tensor"
        output_stream: "TENSORS:detection_tensors"
        node_options: {
          [type.googleapis.com/mediapipe.OpenVINOInferenceCalculatorOptions] {
            tag_to_input_tensor_names { key: "IMAGE" value: "image" }
            output_order: "boxes"
            output_order: "labels"
          }
        }
      }

      node {
        calculator: "OVYoloXTensorsToDetectionsCalculator"
        input_stream: "TENSORS:detection_tensors"
        output_stream: "DETECTIONS:detections"
        node_options: {
          [type.googleapis.com/mediapipe.OVYoloXTensorsToDetectionsCalculatorOptions] {
            conf_thresh: 0.1
            input_size: 416.0
          }
        }
      }