+"""OVMS stubs for iOS/Apple-only rules used inside mediapipe/gpu/BUILD.
+
+OVMS does not target Apple platforms, so these rules are unused at build
+time. Providing no-op definitions keeps mediapipe/gpu/BUILD parseable
+without pulling in @build_bazel_rules_apple.
+"""
+
+def apple_metal_library(name, **kwargs):
+    _ignore = kwargs
+    native.filegroup(name = name, srcs = [])
+
+def ios_unit_test(name, **kwargs):
+    _ignore = kwargs
+    native.filegroup(name = name, srcs = [])
