input_stream: "in"
input_stream: "in2"
output_stream: "out"
node {
  calculator: "OpenVINOSessionCalculator"
  output_side_packet: "SESSION:add"
  node_options: {
    [type.googleapis.com / mediapipe.OpenVINOSessionCalculatorOptions]: {
      model_path: "/ovms/src/test/add_two_inputs_model/1/add.xml"
      shape: "auto"
    }
  }
}
node {
  calculator: "OpenVINOInferenceCalculator"
  input_side_packet: "SESSION:add"
  input_stream: "INPUT1:in"
  input_stream: "INPUT2:in2"
  output_stream: "SUM:out"
  node_options: {
    [type.googleapis.com / mediapipe.OpenVINOInferenceCalculatorOptions]: {
        tag_to_input_tensor_names { key: "INPUT1" value: "input1" }
        tag_to_input_tensor_names { key: "INPUT2" value: "input2" }
        tag_to_output_tensor_names { key: "SUM" value: "sum" }
    }
  }
}
