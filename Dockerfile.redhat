ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi:9.8
ARG BUILD_IMAGE=build
ARG PKG_IMAGE=pkg
ARG RELEASE_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.8
ARG BASE_OS=redhat
ARG GPU=0
ARG NPU=0

FROM $BASE_IMAGE AS gpu-build
SHELL ["/bin/bash", "-xo", "pipefail", "-c"]
ARG JOBS=50
ARG BASE_OS

#hadolint ignore=DL3041
RUN case "$BASE_OS" in redhat|redhat9) redhat_major=9; libdrm_devel=libdrm-devel ;; redhat10) redhat_major=10; libdrm_devel=libdrm-devel-2.4.123-1.el10 ;; *) exit 1 ;; esac && \
    rpm --import https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256 && \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-${redhat_major}.noarch.rpm && \
    dnf --repofrompath=centos-crb,https://mirror.stream.centos.org/${redhat_major}-stream/CRB/\$basearch/os/ \
        --repofrompath=centos-app,https://mirror.stream.centos.org/${redhat_major}-stream/AppStream/\$basearch/os/ \
        --repofrompath=centos-base,https://mirror.stream.centos.org/${redhat_major}-stream/BaseOS/\$basearch/os/ \
        install -y --setopt=install_weak_deps=0 \
        gcc-c++ cmake make git patch pkg-config flex bison python3 python3-mako python3-pyyaml ninja-build \
        libxml2-devel zlib-devel libzstd-devel libva-devel "$libdrm_devel" ocl-icd-devel opencl-headers && \
    dnf clean all

ENV PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig \
    LD_LIBRARY_PATH=/usr/lib64:/usr/lib
WORKDIR /gpu-src
RUN git clone --depth 1 --branch v2.42.6 https://github.com/intel/intel-graphics-compiler.git igc && \
    git clone --depth 1 --branch llvmorg-17.0.6 https://github.com/llvm/llvm-project.git llvm-project && \
    git clone --depth 1 --branch ocl-open-170 https://github.com/intel/opencl-clang.git llvm-project/llvm/projects/opencl-clang && \
    git clone --depth 1 --branch llvm_release_170 https://github.com/KhronosGroup/SPIRV-LLVM-Translator.git llvm-project/llvm/projects/llvm-spirv && \
    git clone https://github.com/intel/vc-intrinsics.git vc-intrinsics && \
    git -C vc-intrinsics checkout e2bb84f509f613b0e36bd131c3a90800b4fe8f88 && \
    git clone https://github.com/KhronosGroup/SPIRV-Tools.git SPIRV-Tools && \
    git -C SPIRV-Tools checkout 8903ea3e94370b9341cfe7c95a8274b3ae783b1b && \
    git clone https://github.com/KhronosGroup/SPIRV-Headers.git SPIRV-Headers && \
    git -C SPIRV-Headers checkout 50184103b19027f5c7080060712d6a9470cf59ee
RUN git config --global user.name "IGC build" && \
    git config --global user.email "igc-build@localhost" && \
    cmake -S igc -B igc-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DIGC_OPTION__LLVM_PREFERRED_VERSION=17.0.6 && \
    cmake --build igc-build --parallel ${JOBS} && \
    cmake --install igc-build && DESTDIR=/gpu-root cmake --install igc-build

RUN git clone --depth 1 --branch intel-gmmlib-22.10.2 https://github.com/intel/gmmlib.git gmmlib && \
    cmake -S gmmlib -B gmmlib-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 && \
    cmake --build gmmlib-build --parallel ${JOBS} && \
    cmake --install gmmlib-build && DESTDIR=/gpu-root cmake --install gmmlib-build && \
    git clone --depth 1 --branch v1.34.0 https://github.com/oneapi-src/level-zero.git level-zero && \
    cmake -S level-zero -B level-zero-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 && \
    cmake --build level-zero-build --parallel ${JOBS} && \
    cmake --install level-zero-build && DESTDIR=/gpu-root cmake --install level-zero-build

ARG INSTALL_DRIVER_VERSION=26.40.40196.8
RUN if [[ "$INSTALL_DRIVER_VERSION" != "26.40.40196.8" ]]; then echo "Unsupported GPU driver version: $INSTALL_DRIVER_VERSION" >&2; exit 1; fi && \
    git clone --depth 1 --branch "$INSTALL_DRIVER_VERSION" https://github.com/intel/compute-runtime.git compute-runtime && \
    cmake -S compute-runtime -B compute-runtime-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DNEO_SKIP_UNIT_TESTS=1 -DNEO_ENABLE_I915_PRELIM_DETECTION=1 && \
    cmake --build compute-runtime-build --parallel ${JOBS} && \
    DESTDIR=/gpu-root cmake --install compute-runtime-build && \
    install -Dm644 igc/LICENSE.md /gpu-root/usr/share/licenses/ovms-gpu/igc-LICENSE.md && \
    install -Dm644 gmmlib/LICENSE.md /gpu-root/usr/share/licenses/ovms-gpu/gmmlib-LICENSE.md && \
    install -Dm644 level-zero/LICENSES/MIT.txt /gpu-root/usr/share/licenses/ovms-gpu/level-zero-LICENSE.txt && \
    install -Dm644 compute-runtime/LICENSE.md /gpu-root/usr/share/licenses/ovms-gpu/compute-runtime-LICENSE.md && \
    install -Dm644 llvm-project/llvm/LICENSE.TXT /gpu-root/usr/share/licenses/ovms-gpu/llvm-LICENSE.txt && \
    install -Dm644 llvm-project/llvm/projects/opencl-clang/LICENSE /gpu-root/usr/share/licenses/ovms-gpu/opencl-clang-LICENSE && \
    install -Dm644 llvm-project/llvm/projects/llvm-spirv/LICENSE.TXT /gpu-root/usr/share/licenses/ovms-gpu/spirv-llvm-translator-LICENSE.txt && \
    install -Dm644 vc-intrinsics/LICENSE.md /gpu-root/usr/share/licenses/ovms-gpu/vc-intrinsics-LICENSE.md && \
    install -Dm644 SPIRV-Tools/LICENSE /gpu-root/usr/share/licenses/ovms-gpu/spirv-tools-LICENSE && \
    install -Dm644 SPIRV-Headers/LICENSE /gpu-root/usr/share/licenses/ovms-gpu/spirv-headers-LICENSE

FROM $BASE_IMAGE AS gpu-0
RUN mkdir -p /gpu-root
FROM gpu-build AS gpu-1
RUN find /gpu-root/usr/lib64 -type f -name '*.so*' -exec strip --strip-unneeded {} + && \
    rm -rf /gpu-root/usr/include /gpu-root/usr/bin /gpu-root/usr/lib64/pkgconfig
FROM gpu-${GPU} AS gpu-runtime

FROM gpu-build AS npu-build
SHELL ["/bin/bash", "-xo", "pipefail", "-c"]
ARG JOBS=50
RUN case "$BASE_OS" in redhat|redhat9) redhat_major=9 ;; redhat10) redhat_major=10 ;; *) exit 1 ;; esac && \
    dnf --repofrompath=centos-crb,https://mirror.stream.centos.org/${redhat_major}-stream/CRB/\$basearch/os/ \
        --repofrompath=centos-app,https://mirror.stream.centos.org/${redhat_major}-stream/AppStream/\$basearch/os/ \
        --repofrompath=centos-base,https://mirror.stream.centos.org/${redhat_major}-stream/BaseOS/\$basearch/os/ \
        install -y --setopt=install_weak_deps=0 git-lfs python3-devel tbb-devel libedit-devel && \
    dnf clean all
WORKDIR /npu-src
RUN git lfs install && \
    git clone --depth 1 --branch v1.39.1 --recurse-submodules https://github.com/intel/linux-npu-driver.git driver && \
    git clone --depth 1 --branch v2021.13.1 https://github.com/oneapi-src/oneTBB.git onetbb
RUN cmake -S onetbb -B onetbb-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 -DTBB_TEST=OFF && \
    cmake --build onetbb-build --parallel ${JOBS} && \
    DESTDIR=/npu-root cmake --install onetbb-build && \
    install -Dm644 onetbb/LICENSE.txt /npu-root/usr/share/licenses/ovms-npu/onetbb-LICENSE.txt
RUN --mount=type=cache,id=ovms-npu-${BASE_OS},target=/npu-src/driver-build,sharing=locked \
    sed -i "s/ProcessorCount(PARALLEL_PROCESSES)/set(PARALLEL_PROCESSES ${JOBS})/" driver/compiler/npu_compiler_build.cmake && \
    cmake -S driver -B driver-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DENABLE_NPU_COMPILER_BUILD=ON -DENABLE_VALIDATION_BUILD=OFF && \
    cmake --build driver-build --target npu_compiler_source --parallel ${JOBS} && \
    compiler_shape_source=driver-build/compiler/src/npu_compiler/src/vpux_compiler/src/dialect/IE/utils/shape_infer.cpp && \
    { grep -q '^#pragma GCC diagnostic warning "-Wmaybe-uninitialized"' "$compiler_shape_source" || \
        sed -i '1i#pragma GCC diagnostic warning "-Wmaybe-uninitialized"' "$compiler_shape_source"; } && \
    cmake --build driver-build --parallel ${JOBS} && \
    DESTDIR=/npu-root cmake --install driver-build && \
    DESTDIR=/npu-root cmake --install driver-build --component fw-npu && \
    mkdir -p /npu-root/usr/lib && \
    mv /npu-root/lib/firmware /npu-root/usr/lib/ && rmdir /npu-root/lib && \
    find /npu-root/usr/lib/firmware/updates/intel/vpu -type f -name '*.bin' -size +1k -print -quit | grep -q . && \
    mkdir -p /npu-root/usr/lib64 && \
    cp -a /gpu-root/usr/lib64/libze_loader.so* /npu-root/usr/lib64/ && \
    install -Dm644 driver/LICENSE.md /npu-root/usr/share/licenses/ovms-npu/driver-LICENSE.md && \
    install -Dm644 driver/third-party-programs.txt /npu-root/usr/share/licenses/ovms-npu/third-party-programs.txt && \
    install -Dm644 /gpu-src/level-zero/LICENSES/MIT.txt /npu-root/usr/share/licenses/ovms-npu/level-zero-LICENSE.txt

FROM $BASE_IMAGE AS npu-0
RUN mkdir -p /npu-root
FROM npu-build AS npu-1
RUN find /npu-root/usr/lib64 -type f -name '*.so*' -exec strip --strip-unneeded {} + && \
    rm -rf /npu-root/usr/include /npu-root/usr/lib64/cmake /npu-root/usr/lib64/pkgconfig
FROM npu-${NPU} AS npu-runtime

FROM $BASE_IMAGE AS drivers-pkg
COPY --from=gpu-1 /gpu-root/ /drivers/gpu/
COPY --from=npu-1 /npu-root/ /drivers/npu/
RUN tar -czf /ovms-drivers.tar.gz -C /drivers .

FROM $BASE_IMAGE as base_build
ARG BASE_IMAGE
ARG BASE_OS

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

ARG JOBS=50
ARG VERBOSE_LOGS=OFF
ARG LTO_ENABLE=OFF
ARG LTO_CXX_FLAGS=""
ARG LTO_LD_FLAGS="-Wl,-z,relro"

# hadolint ignore=DL3041
RUN case "$BASE_OS" in redhat|redhat9) redhat_major=9 ;; redhat10) redhat_major=10 ;; *) exit 1 ;; esac && \
    echo -e "max_parallel_downloads=8\nretries=50" >> /etc/dnf/dnf.conf && \
    curl -fsSL -o /tmp/epel-release.rpm https://dl.fedoraproject.org/pub/epel/epel-release-latest-${redhat_major}.noarch.rpm && \
    dnf install -y /tmp/epel-release.rpm && dnf update -d6 -y && dnf install -d6 -y \
            libuuid-devel \
            bc \
            cmake \
            gcc-c++ \
            git \
            libcurl-devel \
            libtool \
            libxml2-devel \
            make \
            openssl-devel \
            patch \
            pkg-config \
            wget && \
            dnf clean all

# hadolint ignore=DL3003
RUN curl -fsSL https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.gz -o /tmp/nasm.tar.gz && \
    echo "5bc940dd8a4245686976a8f7e96ba9340a0915f2d5b88356874890e207bdb581  /tmp/nasm.tar.gz" | sha256sum -c - && \
    mkdir /tmp/nasm && \
    tar -xzf /tmp/nasm.tar.gz --strip-components=1 -C /tmp/nasm && \
    cd /tmp/nasm && \
    ./configure --prefix=/usr/local && \
    make -j ${JOBS} && \
    make install && \
    cd / && \
    rm -rf /tmp/nasm /tmp/nasm.tar.gz

####### Azure SDK (modern azure-sdk-for-cpp: azure-core, azure-storage-blobs, azure-storage-files-shares)
ARG SDL_OPS="-Wl,-z,relro,-z,now,-z,noexecstack -Wall -Wextra -Wimplicit-fallthrough -fPIE -pie -fstack-protector-strong -fexceptions -fasynchronous-unwind-tables -fcf-protection -fpic -O2 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2 -fno-strict-overflow -Wall -Wno-unknown-pragmas -Wno-error=sign-compare -fno-delete-null-pointer-checks -fwrapv -fstack-clash-protection -Wformat -Wformat-security -Werror=format-security -s -D_GLIBCXX_USE_CXX11_ABI=1 -Wuninitialized"
WORKDIR /azure-sdk-for-cpp
RUN curl -fsSL https://github.com/Azure/azure-sdk-for-cpp/archive/refs/tags/azure-storage-blobs_12.18.0.tar.gz -o /tmp/azure-sdk-for-cpp.tar.gz && \
    echo "0f266f91cf00b79bb6c7c6f99e44942b43a7141db565556a4298f6ebe3a86fcc  /tmp/azure-sdk-for-cpp.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/azure-sdk-for-cpp.tar.gz --strip-components=1 && \
    rm /tmp/azure-sdk-for-cpp.tar.gz && \
    echo "# no-op: use system libcurl and openssl" > /azure-sdk-toolchain.cmake && \
    cmake -S sdk/core/azure-core -B build/azure-core \
        -DCMAKE_TOOLCHAIN_FILE=/azure-sdk-toolchain.cmake \
        -DCMAKE_CXX_FLAGS="${SDL_OPS} ${LTO_CXX_FLAGS}" \
        -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DDISABLE_AZURE_CORE_OPENTELEMETRY=ON \
        -DBUILD_TRANSPORT_CURL=ON && \
    cmake --build build/azure-core --parallel ${JOBS} && \
    cmake --install build/azure-core --prefix /azure-sdk-install && \
    cmake -S sdk/storage/azure-storage-common -B build/azure-storage-common \
        -DCMAKE_TOOLCHAIN_FILE=/azure-sdk-toolchain.cmake \
        -DCMAKE_CXX_FLAGS="${SDL_OPS} ${LTO_CXX_FLAGS}" \
        -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DCMAKE_PREFIX_PATH=/azure-sdk-install && \
    cmake --build build/azure-storage-common --parallel ${JOBS} && \
    cmake --install build/azure-storage-common --prefix /azure-sdk-install && \
    cmake -S sdk/storage/azure-storage-blobs -B build/azure-storage-blobs \
        -DCMAKE_TOOLCHAIN_FILE=/azure-sdk-toolchain.cmake \
        -DCMAKE_CXX_FLAGS="${SDL_OPS} ${LTO_CXX_FLAGS}" \
        -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DCMAKE_PREFIX_PATH=/azure-sdk-install && \
    cmake --build build/azure-storage-blobs --parallel ${JOBS} && \
    cmake --install build/azure-storage-blobs --prefix /azure-sdk-install && \
    cmake -S sdk/storage/azure-storage-files-shares -B build/azure-storage-files-shares \
        -DCMAKE_TOOLCHAIN_FILE=/azure-sdk-toolchain.cmake \
        -DCMAKE_CXX_FLAGS="${SDL_OPS} ${LTO_CXX_FLAGS}" \
        -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DCMAKE_PREFIX_PATH=/azure-sdk-install && \
    cmake --build build/azure-storage-files-shares --parallel ${JOBS} && \
    cmake --install build/azure-storage-files-shares --prefix /azure-sdk-install
####### End of Azure SDK

COPY third_party/pugixml /ovms/third_party/pugixml

# Build and install pugixml
# hadolint ignore=DL3003
RUN curl -fsSL https://github.com/zeux/pugixml/archive/refs/tags/v1.13.tar.gz -o /tmp/pugixml.tar.gz && \
    echo "5c5ad5d7caeb791420408042a7d88c2c6180781bf218feca259fd9d840a888e1  /tmp/pugixml.tar.gz" | sha256sum -c - && \
    mkdir pugixml && \
    tar -xzf /tmp/pugixml.tar.gz --strip-components=1 -C pugixml && \
    rm /tmp/pugixml.tar.gz && \
    cd pugixml && \
    patch -p1 < /ovms/third_party/pugixml/pugixml_v1.13_flags.patch && \
    cmake -DBUILD_SHARED_LIBS=ON -DCMAKE_VERBOSE_MAKEFILE=${VERBOSE_LOGS} \
    -DCMAKE_CXX_FLAGS="${LTO_CXX_FLAGS}" \
    -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" && \
    make all -j ${JOBS} && \
    cp -P libpugixml.so* /usr/lib64/

####### Build OpenCV
COPY third_party/opencv /ovms/third_party/opencv
WORKDIR /ovms/third_party/opencv
ARG OPENCV_VERSION=4.14.0
RUN if [ "$VERBOSE_LOGS" == "ON" ] ; then export VERBOSE=1 ; fi && OPENCV_VERSION=${OPENCV_VERSION} ./install_opencv.sh
####### End of OpenCV

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ #
FROM base_build as build
ARG BASE_IMAGE

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

ARG JOBS=50
ARG VERBOSE_LOGS=OFF
ARG LTO_ENABLE=OFF

# hadolint ignore=DL3041
RUN case "$BASE_OS" in redhat|redhat9) redhat_major=9 ;; redhat10) redhat_major=10 ;; *) exit 1 ;; esac && \
    rpm --import https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official-SHA256 && \
    dnf --repofrompath=centos-crb,https://mirror.stream.centos.org/${redhat_major}-stream/CRB/\$basearch/os/ \
        --repofrompath=centos-app,https://mirror.stream.centos.org/${redhat_major}-stream/AppStream/\$basearch/os/ \
        --repofrompath=centos-base,https://mirror.stream.centos.org/${redhat_major}-stream/BaseOS/\$basearch/os/ \
        install -y -d6 opencl-headers ocl-icd-devel libva-devel \
            gdb \
            java-21-openjdk-devel \
            tzdata-java \
            libgusb.x86_64 \
            libusbx \
            libtool \
            openssl-devel \
            which \
            unzip \
            vim \
            xz \
            python3 \
            python3-devel \
            python3-pip \
            libicu-devel && \
            dnf clean all
# Note: espeak-ng is no longer installed from dnf; it is built from source
# by Bazel (see third_party/espeak_ng) and bundled in the release.

WORKDIR /

COPY --from=gpu-build /gpu-root/ /
WORKDIR /ovms
RUN groupadd --gid 5000 ovms && groupadd --gid 44 video1 && \
    useradd --home-dir /home/ovms --create-home --uid 5000 --gid 5000 --groups 39,44 --shell /bin/bash --skel /dev/null ovms

RUN python3 --version && python3 -m pip install "numpy<2.0.0" "Jinja2==3.1.6" "MarkupSafe==3.0.2" --no-cache-dir

# Set up Bazel
ENV BAZEL_VERSION 7.4.1
WORKDIR /bazel
RUN curl -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/57.0.2987.133 Safari/537.36" -fSsL -O https://github.com/bazelbuild/bazel/releases/download/$BAZEL_VERSION/bazel-$BAZEL_VERSION-installer-linux-x86_64.sh && \
    echo "fcce7df3fdbe8ef9f278816776709292ca7bb42d2facc15fc777649a9b46ca49  bazel-$BAZEL_VERSION-installer-linux-x86_64.sh" | sha256sum -c - && \
    curl -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/57.0.2987.133 Safari/537.36" -fSsL -o /bazel/LICENSE.txt https://raw.githubusercontent.com/bazelbuild/bazel/master/LICENSE && \
    chmod +x bazel-*.sh && \
    ./bazel-$BAZEL_VERSION-installer-linux-x86_64.sh && \
    rm -f /bazel/bazel-$BAZEL_VERSION-installer-linux-x86_64.sh

RUN curl -fsSL -o /tmp/lcov.rpm https://github.com/linux-test-project/lcov/releases/download/v1.16/lcov-1.16-1.noarch.rpm && \
    echo "b737233ec9139ff4b09ee715f912a29dd3dcd9481d9c50ba43082b333587760b  /tmp/lcov.rpm" | sha256sum -c - && \
    dnf install -y /tmp/lcov.rpm && dnf clean all && rm /tmp/lcov.rpm

WORKDIR /patchelf
# hadolint ignore=DL3003
RUN wget -q https://github.com/NixOS/patchelf/archive/0.10.tar.gz && \
    echo "b3cb6bdedcef5607ce34a350cf0b182eb979f8f7bc31eae55a93a70a3f020d13  0.10.tar.gz" | sha256sum -c - && \
    tar -xf 0.10.tar.gz && cd patchelf-0.10 && \
    ./bootstrap.sh && ./configure && make && make install

ENV TF_SYSTEM_LIBS="curl"
ENV TEST_LOG="/root/.cache/bazel/_bazel_root/bc57d4817a53cab8c785464da57d1983/execroot/ovms/bazel-out/test.log"
ARG ov_branch=c01cd93e24d1cd78bfbb401eed51c08fb93e0816
ARG ov_repo=openvinotoolkit/openvino
ARG ov_use_binary=0
ARG DLDT_PACKAGE_URL
ARG DLDT_PACKAGE_SHA256
ARG TEMP_DIR=/tmp/openvino_installer
ARG CMAKE_BUILD_TYPE=Release
ARG debug_bazel_flags="--strip=always  --config=mp_on --//:distro=redhat"

################### BUILD OPENVINO FROM SOURCE - buildarg ov_use_binary=0  ############################
ARG SDL_OPS="-Wl,-z,relro,-z,now,-z,noexecstack -fPIE -pie -fstack-protector-strong -fexceptions -fasynchronous-unwind-tables -fcf-protection -fpic -O2 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2 -fno-strict-overflow -Wno-unknown-pragmas -Wno-error=sign-compare -fno-delete-null-pointer-checks -fwrapv -fstack-clash-protection -Wformat -Wformat-security -s -D_GLIBCXX_USE_CXX11_ABI=1 -Wuninitialized"
# hadolint ignore=DL3041
RUN dnf install -y gflags-devel gflags json-devel fdupes && \
    dnf clean all
# hadolint ignore=DL3003
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false if [ "$ov_use_binary" == "0" ] ; then true ; else exit 0 ; fi ; git clone https://github.com/$ov_repo.git /openvino && cd /openvino && git checkout $ov_branch && git submodule update --init --recursive
RUN if [ "$ov_use_binary" == "0" ]; then true ; else exit 0 ; fi ; python3 -m pip install --no-cache-dir -r /openvino/src/bindings/python/wheel/requirements-dev.txt wheel==0.45.1
WORKDIR /openvino/build
RUN if [ "$ov_use_binary" == "0" ]; then true ; else exit 0 ; fi ; \
    cmake -DCMAKE_BUILD_TYPE=$CMAKE_BUILD_TYPE -DCMAKE_VERBOSE_MAKEFILE="${VERBOSE_LOGS}" -DENABLE_LTO=${LTO_ENABLE} -DENABLE_PYTHON=ON -DENABLE_SAMPLES=0 -DENABLE_CPPLINT=OFF -DENABLE_INTEL_NPU=ON -DENABLE_INTEL_NPU_PROTOPIPE=OFF -DGPU_RT_TYPE=COMBINED -DBUILD_SHARED_LIBS=ON -DCMAKE_CXX_FLAGS="  ${SDL_OPS} -Wno-error=parentheses  ${LTO_CXX_FLAGS} " -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" .. && \
    make --jobs=$JOBS && \
    make install
RUN if [ "$ov_use_binary" == "0" ] ; then true ; else exit 0 ; fi ; \
    mkdir -p /opt/intel/openvino/extras && \
    mkdir -p /opt/intel/openvino && \
    ln -s /openvino/inference-engine/temp/opencv_*/opencv /opt/intel/openvino/extras && \
    ln -s /usr/local/runtime /opt/intel/openvino && \
    ln -s /openvino/scripts/setupvars/setupvars.sh /opt/intel/openvino/setupvars.sh && \
    ln -s /opt/intel/openvino /opt/intel/openvino_2026
RUN if [ "$ov_use_binary" == "0" ]; then true ; else exit 0 ; fi ; mkdir -p /opt/intel/openvino && cp -r /openvino/bin/intel64/Release/python /opt/intel/openvino/
RUN if [ "$ov_use_binary" == "0" ]; then true ; else exit 0 ; fi ; cp -r /openvino/tools/ovc/* /opt/intel/openvino/python
################## END OF OPENVINO SOURCE BUILD ######################

################### TAKE OPENVINO FROM A BINARY RELEASE - buildarg ov_use_binary=1 (DEFAULT) ##########
WORKDIR $TEMP_DIR
# OV toolkit package
RUN if [ "$ov_use_binary" != "1" ] || [ -z "$DLDT_PACKAGE_URL" ]; then exit 0; fi; \
    if [ -z "$DLDT_PACKAGE_SHA256" ]; then echo "DLDT_PACKAGE_SHA256 must be set for binary OpenVINO packages" >&2; exit 1; fi; \
    wget -nv -O openvino_genai.tar.gz "$DLDT_PACKAGE_URL" && \
    echo "$DLDT_PACKAGE_SHA256  openvino_genai.tar.gz" | sha256sum -c - && \
    mkdir /opt/intel && \
    tar -zxf openvino_genai.tar.gz -C /opt/intel && \
    ln -s /opt/intel/*openvino_genai* /opt/intel/openvino && \
    ln -s /opt/intel/*openvino_genai* /opt/intel/openvino_2026

# install sample apps including benchmark_app
# hadolint ignore=DL3041
RUN dnf install -y gflags-devel gflags json-devel && \
    dnf clean all
RUN if [ -f /opt/intel/openvino/samples/cpp/build_samples.sh ];  then /opt/intel/openvino/samples/cpp/build_samples.sh ; fi
#################### END OF OPENVINO BINARY INSTALL

# OpenVINO Tokenizers extension
ENV OpenVINO_DIR=/opt/intel/openvino/runtime/cmake
ENV OPENVINO_TOKENIZERS_PATH_GENAI=/opt/intel/openvino/runtime/lib/intel64/libopenvino_tokenizers.so
ENV LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/intel/openvino/runtime/lib/intel64/:/opt/opencv/lib/:/opt/intel/openvino/runtime/3rdparty/tbb/lib/

WORKDIR /openvino_tokenizers/
ARG ov_tokenizers_branch=85be884a69f10270703f81f970a5ee596a4c8df7
ARG ov_tokenizers_repo=openvinotoolkit/openvino_tokenizers
# hadolint ignore=DL3003
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false git clone https://github.com/$ov_tokenizers_repo.git /openvino_tokenizers && cd /openvino_tokenizers && git checkout $ov_tokenizers_branch && git submodule update --init --recursive && \
    sed -i '/openvino~=/d' /openvino_tokenizers/pyproject.toml && \
    sed -i '/requires-python/d' /openvino_tokenizers/pyproject.toml && \
    cd /openvino_tokenizers && cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_VERBOSE_MAKEFILE="${VERBOSE_LOGS}" -DCMAKE_CXX_FLAGS=" ${SDL_OPS} ${LTO_CXX_FLAGS} " -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" -S ./ -B ./build/  && cmake --build ./build/ --parallel $JOBS && cp -vP /openvino_tokenizers/build/src/lib*.so /opt/intel/openvino/runtime/lib/intel64/ && \
    python3 -m pip wheel -v --no-deps --wheel-dir wheel /openvino_tokenizers && \
    python3 -m pip install --no-cache-dir "$(find wheel -name 'openvino_tokenizers*.whl')" --target /opt/intel/openvino/python

WORKDIR /openvino_genai/
ARG ov_genai_branch=master
ARG ov_genai_repo=openvinotoolkit/openvino.genai
# hadolint ignore=DL3003
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false if [ "$ov_use_binary" == "0" ]; then true ; else exit 0 ; fi ; \
    git clone https://github.com/$ov_genai_repo.git /openvino_genai && cd /openvino_genai && git checkout $ov_genai_branch && git submodule update --init --recursive && \
    cmake -DCMAKE_BUILD_TYPE=$CMAKE_BUILD_TYPE -DCMAKE_CXX_FLAGS=" ${SDL_OPS} ${LTO_CXX_FLAGS} " -DCMAKE_SHARED_LINKER_FLAGS="${LTO_LD_FLAGS}" -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DENABLE_SYSTEM_ICU="True" -DBUILD_TOKENIZERS=OFF -DENABLE_SAMPLES=OFF -DENABLE_TOOLS=OFF -DENABLE_TESTS=OFF -DENABLE_XGRAMMAR=ON -S ./ -B ./build/ && \
    cmake --build ./build/ --parallel $JOBS && cp -vP /openvino_genai/build/openvino_genai/lib*.so* /opt/intel/openvino/runtime/lib/intel64/ && \
    cp -r /openvino_genai/src/cpp/include/* /opt/intel/openvino/runtime/include/ && \
    cp /openvino_genai/build/src/cpp/openvino/genai/version.hpp /opt/intel/openvino/runtime/include/openvino/genai/ && \
    cp -r /openvino_genai/build/openvino_genai/*py* /opt/intel/openvino/python/

# Build OpenVINO Model Server
WORKDIR /ovms
COPY .bazelrc .user.bazelr[c] .bazelversion WORKSPACE /ovms/
# since bazel does not have easy way to pass if down the dependencies to have select the sources
# for libcurl & ssl we hack it this way
RUN ln -s /usr/lib64 /usr/lib/x86_64-linux-gnu
COPY external /ovms/external/
COPY third_party /ovms/third_party

# This path is required for namespace to setup Python dependencies for testing the binding
COPY src/BUILD /ovms/src/BUILD
COPY src/mediapipe_internal/BUILD src/mediapipe_internal/runtime_plugin.bzl /ovms/src/mediapipe_internal/
COPY src/python/binding/BUILD /ovms/src/python/binding/BUILD
COPY src/python/binding/tests/requirements.txt /ovms/src/python/binding/tests/requirements.txt

WORKDIR /ovms

# Mediapipe
COPY BUILD.bazel /ovms/
COPY *\.bzl /ovms/
COPY yarn.lock /ovms/
COPY package.json /ovms/

# hadolint ignore=DL3059
RUN cp -v /etc/ssl/certs/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt

ARG KONFLUX=1  # This is a workaround to avoid bazel fetching dependencies during build, which causes issues in Konflux. Should be disabled when building outside of Konflux to speed up the build by using bazel cache and avoid fetching dependencies which are already cached.
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false if [ "$KONFLUX" == "0" ] ; then true ; else exit 0 ; fi ; \
    bazel build --jobs=$JOBS ${debug_bazel_flags} //:ovms_dependencies @com_google_googletest//:gtest

COPY src/ /ovms/src/

# Sample CPU Extension
WORKDIR /ovms/src/example/SampleCpuExtension/
RUN make

RUN mkdir -p /opt/intel/openvino/python/openvino-4.dist-info && \
    echo $'Metadata-Version: 1.0\nName: openvino\nVersion: 2026.5' > /opt/intel/openvino/python/openvino-4.dist-info/METADATA
ENV PYTHONPATH=/opt/intel/openvino/python:/ovms/bazel-bin/src/python/binding

WORKDIR /ovms

ARG PROJECT_VERSION="2026.5.0"
LABEL description="OpenVINO Model Server"
ARG minitrace_flags

# Set OVMS version strings
RUN bash -c "sed -i -e 's|REPLACE_PROJECT_VERSION|${PROJECT_VERSION}|g' /ovms/src/version.cpp" && \
    bash -c "sed -i -e 's|REPLACE_BAZEL_BUILD_FLAGS|${debug_bazel_flags}${minitrace_flags}|g' /ovms/src/version.cpp"

# OVMS
ARG OPTIMIZE_BUILDING_TESTS=0
RUN rm -f /usr/lib64/cmake/OpenSSL/OpenSSLConfig.cmake

# Builds unit tests together with ovms server in one step
# It speeds up CI when tests are executed outside of the image building
# hadolint ignore=SC2046
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false bazel build --jobs=$JOBS ${debug_bazel_flags} ${minitrace_flags} //src:ovms \
    //src/python:libovmspython //src/python:libpython_calculators \
    $(if [ "$OPTIMIZE_BUILDING_TESTS" == "1" ] ; then echo -n "//src:ovms_test //src:python_runtime_library_test"; fi)

# espeak-ng is built as a separate step, independent of the OVMS binary.
# Set ESPEAK=0 to skip the espeak build.
ARG ESPEAK=1
# hadolint ignore=DL3059
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false if [ "$ESPEAK" == "1" ]; then bazel build --jobs=$JOBS ${debug_bazel_flags} //third_party:espeak_ng //third_party:espeak_ng_data; fi

# Tests execution
COPY ci/check_coverage.bat /ovms/
ARG CHECK_COVERAGE=0
ARG RUN_TESTS=0
COPY run_unit_tests.sh prepare_llm_models.sh prepare_gpu_models.sh demos/common/export_models/export_model.py /ovms/
RUN if [ "$RUN_TESTS" == "1" ] ; then mkdir -p demos/common/export_models/ && mv export_model.py demos/common/export_models/ && ./prepare_llm_models.sh /ovms/src/test/llm_testing docker && ./run_unit_tests.sh ; fi

ARG ovms_metadata_file

RUN /ovms/bazel-bin/src/ovms --version && /ovms/bazel-bin/src/ovms

COPY release_files/thirdparty-licenses/ /ovms/release_files/thirdparty-licenses/
COPY release_files/LICENSE /ovms/release_files/LICENSE
COPY client /client
RUN python3 -c "import json; m={'PROJECT_VERSION':'${PROJECT_VERSION}','OPENVINO backend':'$(/ovms/bazel-bin/src/ovms --version | grep 'OpenVINO backend' | cut -d' ' -f3)', \
    'BAZEL_BUILD_FLAGS':'${debug_bazel_flags}${minitrace_flags}}','BASE_IMAGE':'${BASE_IMAGE}' }; \
    print(json.dumps(m,indent=4))" > /ovms/release_files/metadata.json

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ #

FROM $BUILD_IMAGE as capi-build
# C api shared library
ARG CAPI_FLAGS="--strip=always  --config=mp_off --//:distro=redhat"
ARG JOBS=50
ARG LTO_ENABLE=OFF
WORKDIR /ovms
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false bazel build --jobs $JOBS ${CAPI_FLAGS} //src:ovms_shared //src:ovms_optional_plugins

# C api app with bazel
# hadolint ignore=DL3059
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false bazel build --jobs $JOBS ${CAPI_FLAGS} //src:capi_cpp_example

# C-API benchmark app
RUN --mount=type=secret,id=gitconfig,target=/root/.gitconfig,required=false bazel build --jobs=$JOBS ${CAPI_FLAGS} //src:capi_benchmark && ./bazel-bin/src/capi_benchmark --config_path /ovms/src/test/configs/config_cpu_dummy.json --niter 2 --nstreams 1 --servable_name "dummy"
# C-api C/C++ app with gcc
COPY MakefileCapi /ovms/
RUN make -f MakefileCapi cpp CAPI_FLAGS="${CAPI_FLAGS}" && \
    make -f MakefileCapi c CAPI_FLAGS="${CAPI_FLAGS}"

RUN mkdir -p /ovms_release/lib/ ; find /ovms/bazel-out/k8-*/bin -iname 'libovms_shared.so'  -exec cp -v {} /ovms_release/lib/ \;

FROM $BUILD_IMAGE as pkg

COPY --from=build /usr/local/bin/patchelf /usr/local/bin/patchelf

WORKDIR /
ARG BASE_OS=redhat
ARG ov_use_binary=0
ARG FUZZER_BUILD=0
ARG debug_bazel_flags="--strip=always  --config=mp_on --//:distro=redhat"
COPY create_package.sh /
RUN ./create_package.sh

# hadolint ignore=DL3059
RUN chown -R ovms:ovms /ovms_release
RUN mkdir /licenses && ln -s /ovms_release/LICENSE /licenses && ln -s /ovms_release/thirdparty-licenses /licenses/thirdparty-licenses


FROM $RELEASE_BASE_IMAGE as release
LABEL "name"="OVMS"
LABEL "vendor"="Intel Corporation"
LABEL "version"="2026.5.0"
LABEL "release"="2026"
LABEL "summary"="OpenVINO(TM) Model Server"
LABEL "description"="OpenVINO(TM) Model Server is a solution for serving AI models"
LABEL "maintainer"="dariusz.trawinski@intel.com"
ARG GPU=0
ARG NPU=0
ARG debug_bazel_flags=
LABEL bazel-build-flags=${debug_bazel_flags}
LABEL supported-devices="CPU=1 GPU=${GPU} NPU=${NPU}"
ARG RELEASE_BASE_IMAGE
LABEL base-image=${RELEASE_BASE_IMAGE}

ENV PYTHONPATH=/ovms/lib/python:/ovms/python_deps

WORKDIR /
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY --from=gpu-runtime /gpu-root/ /
COPY --from=npu-runtime /npu-root/ /
# hadolint ignore=DL3003,DL3041,SC2164,SC1091
RUN if [ -f /usr/bin/dnf ] ; then export DNF_TOOL=dnf ; echo -e "max_parallel_downloads=8\nretries=50" >> /etc/dnf/dnf.conf ; else export DNF_TOOL=microdnf ; fi ; \
    $DNF_TOOL upgrade --setopt=install_weak_deps=0 --nodocs -y ; \
    # espeak-ng shared library + data are shipped inside /ovms by the Bazel
    # build (controlled via --//:espeak=on/off in debug_bazel_flags);
    # no system package is required at runtime.
    if [ "$GPU" == "1" ] ; then \
        $DNF_TOOL install -y libdrm libva libedit libnl3 ocl-icd --setopt=install_weak_deps=0 --nodocs && \
        ldconfig; \
    fi ; \
    if [ "$NPU" == "1" ] ; then ldconfig || exit 1; fi ; \
    # For image with Python enabled install Python library
    $DNF_TOOL install -y python3-libs --setopt=install_weak_deps=0 --nodocs; \
    $DNF_TOOL install -y shadow-utils; \
    $DNF_TOOL clean all ; \
    cp -v /etc/ssl/certs/ca-bundle.crt /etc/ssl/certs/ca-certificates.crt ; \
    groupadd --gid 5000 ovms && groupadd --gid 44 video1 && \
    useradd --home-dir /home/ovms --create-home --uid 5000 --gid 5000 --groups 39,44 --shell /bin/bash --skel /dev/null ovms

ENV LD_LIBRARY_PATH=/ovms/lib
ENV PATH="$PATH:/ovms/bin"
ENTRYPOINT ["/ovms/bin/ovms"]

COPY --from=pkg /ovms_release /ovms
COPY --from=build /usr/local/lib64/python3.*/site-packages/numpy /ovms/python_deps/numpy/
COPY --from=build /usr/local/lib64/python3.*/site-packages/numpy.libs /ovms/python_deps/numpy.libs/
COPY --from=build /usr/local/lib64/python3.*/site-packages/numpy-*.dist-info /ovms/python_deps/
COPY --from=pkg /usr/local/lib/python3.*/site-packages/jinja2 /ovms/python_deps/jinja2
COPY --from=pkg /usr/local/lib/python3.*/site-packages/jinja2-3.1.6.dist-info /ovms/python_deps/jinja2-3.1.6.dist-info
COPY --from=pkg /usr/local/lib64/python3.*/site-packages/MarkupSafe-3.0.2.dist-info /ovms/python_deps/MarkupSafe-3.0.2.dist-info
COPY --from=pkg /usr/local/lib64/python3.*/site-packages/markupsafe /ovms/python_deps/markupsafe

RUN mkdir -p /licenses && \
    cp /ovms/LICENSE /licenses/LICENSE && \
    cp -r /ovms/thirdparty-licenses /licenses/thirdparty-licenses && \
    if [ -d /usr/share/licenses/ovms-gpu ]; then cp -r /usr/share/licenses/ovms-gpu /licenses/ovms-gpu; fi && \
    if [ -d /usr/share/licenses/ovms-npu ]; then cp -r /usr/share/licenses/ovms-npu /licenses/ovms-npu; fi && \
    if [ "$NPU" == "1" ]; then \
        test -f /usr/lib64/libze_loader.so.1 && \
        test -f /usr/lib64/libze_intel_npu.so.1 && \
        test -f /usr/lib64/libtbb.so.12 && \
        test -f /usr/lib64/libopenvino_intel_npu_compiler.so && \
        test -f /usr/lib64/libopenvino_intel_npu_compiler_loader.so && \
        test -f /ovms/lib/libopenvino_intel_npu_plugin.so && \
        for library in /usr/lib64/libze_loader.so.1 /usr/lib64/libze_intel_npu.so.1 \
            /usr/lib64/libopenvino_intel_npu_compiler*.so /ovms/lib/libopenvino_intel_npu_plugin.so; do \
            dependencies=$(ldd "$library") || exit 1; \
            printf '%s\n' "$dependencies"; \
            if grep -q 'not found' <<< "$dependencies"; then exit 1; fi; \
        done || exit 1; \
    fi
USER ovms
